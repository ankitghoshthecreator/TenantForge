# Copy this file to .env and fill in values for local development
DATABASE_URL=postgresql+asyncpg://tenantforge:tenantforge_secret@localhost:5432/tenantforge
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production-use-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
