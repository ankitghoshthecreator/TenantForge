DATABASE_URL=postgresql+asyncpg://tenantforge:tenantforge_secret@localhost:5432/tenantforge
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production-use-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
# MinIO / S3 archival (use empty S3_ENDPOINT_URL for real AWS)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=tenantforge-archival
S3_REGION=us-east-1
